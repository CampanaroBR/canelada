generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrações no Neon precisam de conexão DIRETA (sem pgbouncer) — advisory
  // locks de sessão não funcionam direito com pooling em modo transação.
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  apelido       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  jogador       Jogador?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?  
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Grupo {
  id          String   @id @default(cuid())
  nome        String
  slug        String   @unique
  inviteCode  String   @unique @default(dbgenerated("gen_random_uuid()"))
  createdAt   DateTime @default(now())

  jogadores   Jogador[]
  rodadas     Rodada[]
  convidados  Convidado[]
}

enum RoleGrupo {
  SUPER_ADMIN
  ADMIN
  PLAYER
}

/** Papel no gol (sorteio de times). FIXO = goleiro de verdade; CURINGA = joga
 *  na linha, mas pega o gol se faltar fixo. */
enum PapelGol {
  FIXO
  CURINGA
}

/** Força estimada do convidado, já que ele não tem OVR (não é votado).
 *  Vira média do grupo ajustada — ver `notaDoConvidado` em sorteioConvidados.ts. */
enum NivelConvidado {
  FRACO
  MEDIO
  FORTE
}

/**
 * Quem joga o baba mas NÃO tem conta no app — e não vai ter. Existe só pro
 * sorteio: não vota, não é votado, não entra em ranking/badges/Seleção (decidido
 * com o usuário — quem não usa o app não teria como receber prêmio nem se
 * defender de um bagre).
 *
 * Diferente de `Rodada.pendentes`, que é nome da lista esperando ser VINCULADO a
 * um cadastrado. Convidado é permanente: cadastra uma vez, nas próximas rodadas
 * só marca a chegada.
 */
model Convidado {
  id        String         @id @default(cuid())
  grupoId   String
  nome      String
  nivel     NivelConvidado @default(MEDIO)
  papelGol  PapelGol?
  /** Parou de vir? some das listas sem apagar o histórico. */
  ativo     Boolean        @default(true)
  createdAt DateTime       @default(now())

  grupo     Grupo          @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  chegadas  Chegada[]

  @@unique([grupoId, nome])
}

model Jogador {
  id          String    @id @default(cuid())
  userId      String    @unique
  grupoId     String
  apelido     String
  nomeNoBaba  String?
  nome        String?
  sobrenome   String?
  posicao     String?
  peDominante String?
  foto        String?
  role        RoleGrupo @default(PLAYER)
  // Papel no gol pro sorteio de times. null = jogador de linha puro.
  // FIXO = goleiro de verdade; CURINGA = de linha, mas topa pegar o gol quando
  // falta goleiro. NÃO dá pra derivar isso dos votos (quem leva Frangueiro pode
  // ter ido pro gol de brincadeira) — por isso é campo próprio.
  papelGol    PapelGol?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])
  grupo       Grupo     @relation(fields: [grupoId], references: [id])
  votosRecebidos  Voto[]   @relation("VotadoVotos")
  votosEmitidos   Voto[]   @relation("VotanteVotos")
  traitsRecebidas JogadorTrait[]
  pushSubscriptions PushSubscription[]
  badgeUnlocks    BadgeUnlock[]
  rodadasPresente Rodada[]       @relation("RodadaPresentes")
  chegadas        Chegada[]
}

/**
 * Ordem de chegada no baba — base do sorteio ("os primeiros jogam primeiro").
 *
 * Tabela SEPARADA de propósito. A presença vive em `Rodada.presentes` (m2m
 * implícita `_RodadaPresentes`, ~105 linhas), que é lida por ranking, badges,
 * feed e votação. Transformar aquela relação em explícita só pra caber a ordem
 * obrigaria a mexer em todas essas telas de uma vez. Aqui é aditivo: quem já
 * funciona continua igual, e o sorteio lê daqui.
 *
 * `ordem` é a fonte da fila (o admin pode corrigir se marcar fora de sequência);
 * `chegouEm` fica pro histórico.
 */
model Chegada {
  id          String   @id @default(cuid())
  rodadaId    String
  /** Exatamente UM dos dois é preenchido: cadastrado OU convidado. */
  jogadorId   String?
  convidadoId String?
  ordem       Int
  chegouEm    DateTime @default(now())

  rodada      Rodada     @relation(fields: [rodadaId], references: [id], onDelete: Cascade)
  jogador     Jogador?   @relation(fields: [jogadorId], references: [id], onDelete: Cascade)
  convidado   Convidado? @relation(fields: [convidadoId], references: [id], onDelete: Cascade)

  @@unique([rodadaId, jogadorId])
  @@unique([rodadaId, convidadoId])
  @@index([rodadaId, ordem])
}

model BadgeUnlock {
  id         String   @id @default(cuid())
  jogadorId  String
  slug       String
  createdAt  DateTime @default(now())

  jogador    Jogador  @relation(fields: [jogadorId], references: [id], onDelete: Cascade)

  @@unique([jogadorId, slug])
  @@index([jogadorId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  jogadorId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  jogador   Jogador  @relation(fields: [jogadorId], references: [id], onDelete: Cascade)
}

model Rodada {
  id             String       @id @default(cuid())
  grupoId        String
  data           DateTime     @default(now())
  encerrada      Boolean      @default(false)
  votacaoAberta  Boolean      @default(false)
  createdAt      DateTime     @default(now())
  // Nomes da lista do baba que não tinham conta no app na hora da criação da
  // rodada. Admin resolve depois (antes ou durante a votação) associando
  // cada nome a um jogador cadastrado, em /votacao/presenca.
  pendentes      String[]     @default([])

  grupo       Grupo        @relation(fields: [grupoId], references: [id])
  votos       Voto[]
  stories     Story[]
  // Lista de presença: quem realmente jogou (ou foi marcado presente) nessa
  // rodada, editável manualmente. Vazio = sem restrição (mostra todo o grupo,
  // comportamento antigo — mantém rodadas passadas funcionando sem migração).
  presentes   Jogador[]    @relation("RodadaPresentes")
  // Ordem de chegada (ver model Chegada). Convive com `presentes`: aquela diz
  // QUEM jogou, esta diz em QUE ORDEM chegou.
  chegadas    Chegada[]
}

model Voto {
  id          String     @id @default(cuid())
  rodadaId    String
  votanteId   String
  votadoId    String
  categoria   CategoriaVoto
  traitSlug   String?
  createdAt   DateTime   @default(now())
  // O votante JOGOU essa rodada? Serve pro dono do grupo (SUPER_ADMIN), que pode
  // votar sem ter jogado: nesse caso ele responde "não joguei" e o voto NÃO conta
  // participação (ranking/badges). Default true preserva todo o histórico, onde
  // votar exigia presença.
  votanteJogou Boolean   @default(true)

  rodada      Rodada     @relation(fields: [rodadaId], references: [id])
  votante     Jogador    @relation("VotanteVotos", fields: [votanteId], references: [id])
  votado      Jogador    @relation("VotadoVotos", fields: [votadoId], references: [id])
  trait       Trait?     @relation(fields: [traitSlug], references: [slug])

  @@unique([rodadaId, votanteId, categoria, traitSlug])
}

enum CategoriaVoto {
  MVP
  BAGRE
  RACUDO
  RESENHA
  TRAIT
}

model Trait {
  slug        String         @id
  nome        String
  descricao   String?
  categoria   TraitCategoria
  emoji       String?
  // Peso pro placar ponderado da Seleção da Rodada (score = peso × nº de
  // votos, somado por jogador entre todos os traits do mesmo lado). 3 =
  // decide o jogo sozinho (Matador, Categoria, Paredão, Bagre da Noite,
  // Frangueiro), 2 = impacto real (Raçudo, Xerife, Driblador, Garçom,
  // Bragueiro, Reclamão, Pregueiro), 1 = mais estilo/comportamento que
  // resultado (Resenha Forte, Paneleiro, Firuleiro). Default 1 pra traits
  // fora da votação ativa.
  peso        Int            @default(1)

  jogadores   JogadorTrait[]
  votos       Voto[]
}

enum TraitCategoria {
  FUTEBOL
  PERSONALIDADE
  RESENHA
}

model JogadorTrait {
  id          String   @id @default(cuid())
  jogadorId   String
  traitSlug   String
  contador    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jogador     Jogador  @relation(fields: [jogadorId], references: [id])
  trait       Trait    @relation(fields: [traitSlug], references: [slug])

  @@unique([jogadorId, traitSlug])
}

model Story {
  id          String    @id @default(cuid())
  rodadaId    String
  texto       String
  tipo        StoryTipo
  createdAt   DateTime  @default(now())

  rodada      Rodada    @relation(fields: [rodadaId], references: [id])
}

enum StoryTipo {
  MVP
  BAGRE
  TRAIT_CONQUISTADA
  SELECAO
  SEQUENCIA
}
